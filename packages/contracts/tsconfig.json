{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "composite": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "mocha"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "hardhat.config.ts",
    "typechain-types/**/*.ts"
  ]
}
